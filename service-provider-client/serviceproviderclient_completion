# Generates completions for the options and subcommands of the `serviceproviderclient` command.
function _picocli_serviceproviderclient() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands="capabilities deliveries subscriptions privatechannels messages"
  local flag_opts="-h --help -V --version"
  local arg_opts="-u --user -k --keystorepath -s --keystorepassword -t --truststorepath -w --truststorepassword"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    -u|--user)
      return
      ;;
    -k|--keystorepath)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    -s|--keystorepassword)
      return
      ;;
    -t|--truststorepath)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    -w|--truststorepassword)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

